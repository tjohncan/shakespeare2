# Copy to .env and adjust as needed. docker-compose reads .env automatically.

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
# Model is pulled automatically by the ollama-bootstrap service on first up.
OLLAMA_MODEL=dolphin-llama3:8b
# dolphin-llama3:8b gives nice enough results (to my taste) in a tolerable timeframe, running on my laptop
# try dolphin-phi for lightweight cloud-deployed resource usage (ex: t4g.medium) at the expense of output quality

# Optional Ollama generation parameters (unset => use Ollama defaults)
OLLAMA_TEMPERATURE=0.777
OLLAMA_NUM_PREDICT=333

# ---------------------------------------------------------------------------
# App runtime
# ---------------------------------------------------------------------------
# UI title and tagline, substituted into static files at load time.
# APP_TITLE lands in index.html (<title>, <h1>) and the PWA webmanifest.
# APP_TAGLINE lands under the title in index.html.
# Defaults: "shakespeare2" / "request a poem in the style of the bard".
# APP_TITLE=
# APP_TAGLINE=

# Framework log level: debug | info | warn | error.
# DEBUG shows per-request dispatch and WebSocket frame traces;
# INFO is quieter (lifecycle events + WS upgrades/closes only).
# Defaults to DEBUG for this app.
# LOG_LEVEL=debug

# Comma-separated list of allowed Origin values for WebSocket upgrades.
# Leave unset to allow same-origin only (recommended for single-domain deploys).
# Example: ALLOWED_ORIGINS=https://shakespeare2.example.com,https://www.example.com
# ALLOWED_ORIGINS=

# Hard cap on characters accepted in a poem prompt (default 200).
# Ridiculousness firewall — the UX is short inspiration text.
# MAX_INPUT_CHARS=200

# Hard cap on characters streamed to the client per generation (default 3000).
# Sized for ~1.5× SPIRIT's 24-line / 16-syllable ceiling.
# MAX_OUTPUT_CHARS=3000

# Hard cap on newlines emitted per generation (default 40).
# Complements MAX_OUTPUT_CHARS — catches sparse-output pathologies (lots of
# blank lines, few total characters) that a char cap alone would miss.
# MAX_OUTPUT_LINES=40

# ---------------------------------------------------------------------------
# Auth (only read when SHAKESPEARE2_AUTH=true)
#
# This app acts as a CONFIDENTIAL OAuth2 client: the code -> token exchange
# happens server-side with client_key_id + client_secret, and the browser
# only ever sees an opaque session cookie.
# ---------------------------------------------------------------------------
SHAKESPEARE2_AUTH=false

# Required when SHAKESPEARE2_AUTH=true
# AUTH_SERVER_URL=https://auth.example.com
# AUTH_REDIRECT_URI=https://shakespeare2.example.com/callback
# AUTH_CLIENT_ID=hex-uuid-of-this-client
# AUTH_CLIENT_KEY_ID=hex-uuid-of-the-client-key
# AUTH_CLIENT_SECRET=plaintext-client-secret

# Optional — only needed if you call /introspect (admin/background use)
# AUTH_RS_ID=hex-uuid-of-the-resource-server
# AUTH_RS_KEY_ID=hex-uuid-of-the-rs-key
# AUTH_RS_SECRET=plaintext-rs-secret

# Endpoint paths on the auth server. Defaults match Tiger's auth-server.
# AUTH_AUTHORIZE_PATH=/authorize
# AUTH_TOKEN_PATH=/token
# AUTH_INTROSPECT_PATH=/introspect
# AUTH_REVOKE_PATH=/revoke

# Requested OAuth2 scope (space-separated). Leave unset to omit entirely.
# AUTH_SCOPE=openid

# Where to land users after /logout (defaults to /).
# AUTH_POST_LOGOUT_REDIRECT=https://shakespeare2.example.com/

# Session policy
# SESSION_COOKIE_NAME=shakespeare2_session
# SESSION_COOKIE_SECURE=true         # set to false only for plain-HTTP local dev
# SESSION_TTL_SECONDS=28800          # 8 hours

# ---------------------------------------------------------------------------
# Admin API (localhost-only)
#
# Enables /admin/* endpoints that wrap the auth-server's RS user-provisioning
# API (invite, lookup, link, unlink, list). Unset = disabled (paths return
# 404). Requires AUTH_RS_{ID,KEY_ID,SECRET} above.
#
# nginx blocks /admin/* from the public internet. Operators reach it via:
#   docker exec app curl -H "X-Admin-Token: $ADMIN_API_TOKEN" \
#     -H "Content-Type: application/json" \
#     -d '{"email":"alice@example.com"}' \
#     http://127.0.0.1:8080/admin/users
#
# Use a long random string (≥32 bytes).
# ADMIN_API_TOKEN=

# ---------------------------------------------------------------------------
# TLS deployment (docker-compose.prod.yml overlay only)
#
# Only required when nginx + certbot run on this host (no ALB in front).
# For localhost or ALB/CloudFront deployments, leave these unset and don't
# include docker-compose.prod.yml in your up command.
#
# See docker-compose.prod.yml header for the full one-time setup sequence
# (DNS → envsubst nginx config → standalone initial cert → compose up), or
# use `make deploy-tls` which wraps the first bring-up.
# ---------------------------------------------------------------------------
# DOMAIN=shakespeare2.example.com
# ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Build / dev
# ---------------------------------------------------------------------------
# Non-default web-skeleton location (optional — default is ../web-skeleton/)
# WEB_SKELETON_PATH=/path/to/web-skeleton
